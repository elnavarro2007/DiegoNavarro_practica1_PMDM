<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">


    <TextView
        android:id="@+id/textoPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Que edad tienes?"
        android:textSize="25dp"
        android:textStyle="bold"
        android:padding="24dp"
        android:textColor="@color/rojoPastel"
        />

    <EditText
        android:id="@+id/edad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:hint="introduceme_tu_edad"
        android:gravity="center"
        android:inputType="phone"

        />

    <Button
        android:id="@+id/boton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginVertical="20dp"
        android:backgroundTint="@color/rojoPastel"
        android:text="@string/calcular"
        android:textSize="15dp"
        />

    <TextView
        android:id="@+id/textoRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="@string/hola"
        android:textSize="16dp"
        android:textStyle="bold"
        android:padding="24dp"
        android:textColor="@color/rojoPastel"
        />

    <ImageView
        android:id="@+id/imagen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/perro"
        android:layout_marginHorizontal="20px"

        />

</LinearLayout>